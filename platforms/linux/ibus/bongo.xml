<?xml version="1.0" encoding="utf-8"?>
<!-- Bongo IBus Component Descriptor -->
<component>
    <name>org.freedesktop.IBus.Bongo</name>
    <description>Bongo Native Bengali Input Method for Linux</description>
    <version>1.0.0</version>
    <license>MPL-2.0</license>
    <author>Mehedi Shakeel &lt;mehedi@mehedishakeel.com&gt;</author>
